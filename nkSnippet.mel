// /////////////////////////////////////////////////////////////////////////////
/*-
@returns <>
@remarks カテゴリ。
*/
proc test0() {
  print("test0 start\n");
  string $r;

  $r = assertStringEqual("a", "a"); if (`size $r`) warning $r;

  print("test0 end\n");
}

/*-
@param $num <int>
@returns <>
*/
global proc nkSnippetTest(int $num) {
  // ライブラリ初期化
  // nkLibraryInitialize(false);

  // ツール初期化
  // nkTemplateInitialize();

  if ($num < 0 || $num == 0) test0();
}

